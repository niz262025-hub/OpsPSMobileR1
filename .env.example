# Public Expo environment variables used by browser/client code.
# These values must be set in the deployment platform's project settings, not committed with real credentials.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Deep-link callback for Supabase Auth email confirmation / magic-link flows.
# Production app should use a custom scheme or a valid HTTPS callback URL.
EXPO_PUBLIC_APP_SCHEME=opsps
EXPO_PUBLIC_SITE_URL=https://your-production-domain.example.com
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=https://your-production-domain.example.com/auth/callback

# Public payment settings for sandbox-safe checkout only.
# These values remain non-secret and may be exposed to the browser only in the sandbox/dev context.
EXPO_PUBLIC_PAYMENT_PROVIDER=stripe
EXPO_PUBLIC_PAYMENT_ENV=sandbox
EXPO_PUBLIC_PAYMENT_SUCCESS_URL=https://your-sandbox-domain.example.com/payments/success
EXPO_PUBLIC_PAYMENT_CANCEL_URL=https://your-sandbox-domain.example.com/payments/cancel

# Server-side secrets must never be placed in EXPO_PUBLIC_* variables.
# Example (server-only, not for the browser):
# PAYMENT_PROVIDER_NAME=stripe
# PAYMENT_PROVIDER_ENV=sandbox
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
# PAYMENT_PROVIDER_PUBLIC_KEY=
# PAYMENT_PROVIDER_PRIVATE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
