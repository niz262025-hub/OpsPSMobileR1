# Public Expo environment variables used by browser/client code.
# These values must be set in the deployment platform's project settings, not committed with real credentials.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Deep-link callback for Supabase Auth email confirmation / magic-link flows.
# Production app should use a custom scheme or a valid HTTPS callback URL.
EXPO_PUBLIC_APP_SCHEME=opsps
EXPO_PUBLIC_SITE_URL=https://your-production-domain.example.com
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=https://your-production-domain.example.com/auth/callback

# Server-side secrets must never be placed in EXPO_PUBLIC_* variables.
# Example (server-only, not for the browser):
# SUPABASE_SERVICE_ROLE_KEY=
